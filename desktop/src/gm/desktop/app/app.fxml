<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gm.desktop.app.AppController">

    <top>
        <VBox spacing="6.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="6.0" left="10.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button fx:id="loadFileButton" text="Load File" onAction="#onLoadFileClicked"
                        minWidth="90.0"/>
                <TextField fx:id="loadedFilePathField" editable="false"
                           promptText="No file loaded" focusTraversable="false">
                    <HBox.hgrow>
                        <Priority fx:constant="ALWAYS"/>
                    </HBox.hgrow>
                </TextField>
            </HBox>

            <!-- Only visible while a load is running, and takes no space when hidden. -->
            <HBox fx:id="progressBox" alignment="CENTER_LEFT" spacing="10.0"
                  visible="false" managed="false">
                <ProgressBar fx:id="loadProgressBar" prefWidth="220.0" progress="0.0"/>
                <Label fx:id="loadStatusLabel"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" disable="true">
            <tabs>
                <Tab fx:id="eventsTab" text="Events">
                    <content>
                        <fx:include fx:id="eventsView" source="../events/events-tab.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="usersTab" text="Users">
                    <content>
                        <fx:include fx:id="usersView" source="../users/users-tab.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
